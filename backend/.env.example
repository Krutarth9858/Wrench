PROJECT_NAME="Wrench API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database
# Local (Homebrew PostgreSQL):
#   DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/wrench"
# docker-compose passes:
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@db:5432/wrench"

# Test database used by pytest (see backend/tests/conftest.py).
# Optional: defaults to postgresql+asyncpg://postgres@localhost:5432/wrench_test
# TEST_DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/wrench_test"

# Security — REQUIRED. Startup fails if unset; there is no default.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="<generate-a-64-char-hex-secret-do-not-commit-the-real-value>"

# CORS — comma-separated or JSON array. Vite dev server default:
BACKEND_CORS_ORIGINS="http://localhost:5173"
