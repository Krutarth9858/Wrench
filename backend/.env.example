PROJECT_NAME="Wrench API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database
# Local (Homebrew PostgreSQL):
#   DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/wrench"
# docker-compose passes:
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@db:5432/wrench"

# Test database used by pytest (see backend/tests/conftest.py).
# Optional: defaults to postgresql+asyncpg://postgres@localhost:5432/wrench_test
# TEST_DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/wrench_test"

# Security — REQUIRED. Startup fails if unset; there is no default.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="<generate-a-64-char-hex-secret-do-not-commit-the-real-value>"

# CORS — comma-separated or JSON array. Vite dev server default:
BACKEND_CORS_ORIGINS="http://localhost:5174"

# AI diagnostics (RAD FR-06). Defaults to an offline stub so the app runs and the
# test suite passes with no credentials and no network.
#   LLM_PROVIDER="stub"      # or "gemini"
#   LLM_API_KEY=""           # required for a real provider; never commit a real key
#   LLM_MODEL="gemini-2.0-flash"

# Timezone appointment wall-clock times are expressed in (any IANA name).
# System timestamps stay UTC regardless of this setting.
APP_TIMEZONE="Asia/Kolkata"

# Payments. Defaults to an offline stub so the app runs without an account.
PAYMENT_PROVIDER="stub"
# Live Razorpay. Never commit real values.
# PAYMENT_PROVIDER="razorpay"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# Configured on the webhook in the Razorpay dashboard — a DIFFERENT credential
# from RAZORPAY_KEY_SECRET. Without it, webhooks are rejected.
# RAZORPAY_WEBHOOK_SECRET=""

# ── Google Sign-In ────────────────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
#   -> OAuth client ID -> Application type: Web application.
# Register GOOGLE_REDIRECT_URI below as an "Authorised redirect URI" verbatim.
# The secret is server-side only and is never sent to a browser.
# Leave blank to disable Google Sign-In; /auth/google/url then returns 503.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Development. Production must use the deployed origin, e.g.
#   https://app.example.com/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:5174/auth/google/callback"

# ── Transactional email ───────────────────────────────────────────────────────
# console = offline default; records messages in memory, sends nothing.
# resend  = real delivery via https://resend.com (API key from the dashboard).
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
# Must be a domain verified with the provider.
EMAIL_FROM="Wrench <onboarding@resend.dev>"

# ── Email OTP policy ──────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_PER_HOUR=20
