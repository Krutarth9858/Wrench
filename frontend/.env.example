# Base URL of the Wrench backend's versioned API.
# Must include the /api/v1 prefix. Defaults to this value when unset.
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# CARTO basemap key (https://carto.com/basemaps/apikey).
# Travels in the tile URL and is therefore public — Leaflet loads tiles via
# <img>, which cannot send an Authorization header. Restrict it by domain in
# the CARTO dashboard. Leave blank for a watermarked but working map.
VITE_CARTO_API_KEY=""
