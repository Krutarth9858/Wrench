# ==============================================================================
# Wrench — Production Deployment Environment Variables
# Single source of configuration for Docker Compose on AWS EC2 (Instance i-09cb4321863636d82)
# Server Elastic IP: 13.202.225.48 | RAM: 8 GiB | Ubuntu 24.04 LTS
# ==============================================================================

# ── 1. Host Networking (Multi-Site Port Allocation) ───────────────────────────
# Port 8085 selected to avoid collision with amitkhatri (8080) and kelvion (8000/3000)
PORT=8085
HOST_BIND_IP=0.0.0.0

# Dedicated internal loopback ports
DB_PORT=5435
BACKEND_PORT=8005

# ── 2. Database Configuration ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=WrenchSecurePostgresPass2026!
POSTGRES_DB=wrench

# ── 3. Application Security (REQUIRED) ────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=9a4f61f7e3d29a502c3c6f8b919d846b7a2e8c1d3f5b7a9c0e2d4f6a8b0c2e4f

# "production" | "development"
ENVIRONMENT=production

# Keep enabled for evaluation / demo without paid third-party accounts
ALLOW_DEV_STUBS_IN_PROD=true

# CORS: Comma-separated or "*" when accessed via IP/Port or reverse proxy
BACKEND_CORS_ORIGINS=*
APP_TIMEZONE=Asia/Kolkata

# ── 4. Initial Provisioning & Auto-Seed ────────────────────────────────────────
# Automatically runs Alembic migrations and provisions initial accounts on boot
AUTO_SEED=true

# Super Admin Account credentials (auto-created on boot)
ADMIN_EMAIL=admin@wrench.com
ADMIN_PASSWORD=AdminSecure2026!
ADMIN_PHONE=+919876543200

# ── 5. AI Diagnostics (Google Gemini) ─────────────────────────────────────────
# "stub" (works offline with canned advice) or "gemini" (requires GEMINI API key)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ── 6. Digital Payments (Razorpay) ────────────────────────────────────────────
# "stub" (works offline, simulates successful payments) or "razorpay"
PAYMENT_PROVIDER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── 7. Email / OTP Delivery ───────────────────────────────────────────────────
# "smtp" (e.g. Gmail with App Password), "resend", or "console"
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM="Wrench <mihirdarji2511@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mihirdarji2511@gmail.com
SMTP_PASSWORD="gdad jvfi csrx jqgb"
SMTP_TLS=true
SMTP_FROM="Wrench <mihirdarji2511@gmail.com>"

# ── 8. Google OAuth (Optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wrench.amitkhatri.co.in/auth/google/callback
